<Window x:Class="SessionPerfTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SessionPerfTracker.App.Views"
        mc:Ignorable="d"
        Title="{Binding AppWindowTitle}"
        Icon="Assets/app.ico"
        Width="1420"
        Height="860"
        MinWidth="1220"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116"
        FontFamily="Segoe UI">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="{Binding AppWindowTitle}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary Source="Themes/MainWindowResources.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,9"
                Background="#12171E"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="Assets/app.ico"
                           Width="22"
                           Height="22"
                           Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding AppWindowTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{DynamicResource Ui_AppSubtitle}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="{DynamicResource Ui_ReportBugQuick}"
                        Click="ReportBug_Click"
                        Style="{StaticResource InfoButton}"
                        MinWidth="92" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="14,7"
                Background="#1B1710"
                BorderBrush="#6C5931"
                BorderThickness="0,0,0,1"
                Visibility="{Binding ShowTrustExplainer, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="4"
                        CornerRadius="2"
                        Background="{StaticResource WarnBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Ui_EarlyVersionTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Text="{DynamicResource Ui_EarlyVersionBody}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14,6"
                Background="#111C24"
                BorderBrush="#315C7A"
                BorderThickness="0,0,0,1"
                Visibility="{Binding ShowTrustExplainer, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="4"
                            CornerRadius="2"
                            Background="{StaticResource ItemSelectedBorderBrush}" />
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource Ui_TrustExplainerTitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Ui_TrustExplainerBody}"
                               Grid.Column="4"
                               Style="{StaticResource MutedText}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
                <Button Grid.Column="2"
                        Content="{DynamicResource Ui_TrustExplainerDismiss}"
                        Click="DismissTrustExplainer_Click"
                        Style="{StaticResource TertiaryButton}"
                        MinHeight="28"
                        Padding="10,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="12,7"
                Background="#12171E"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasCrossScreenMonitoringStrip, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CrossScreenMonitoringStripText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Content="{DynamicResource Ui_OpenLive}"
                        Click="OpenLive_Click"
                        Style="{StaticResource CompactButton}" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="4"
                    TabStripPlacement="Left"
                    Padding="14,18,18,18"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{DynamicResource Ui_Live}">
                <views:LiveMonitoringView />
            </TabItem>

            <TabItem Header="{DynamicResource Ui_GlobalWatch}">
                <views:GlobalWatchView />
            </TabItem>

            <TabItem Header="{DynamicResource Ui_Sessions}">
                <views:SessionsView />
            </TabItem>

            <TabItem Header="{DynamicResource Ui_Details}">
                <views:SessionDetailsView />
            </TabItem>

            <TabItem Header="{DynamicResource Ui_Compare}">
                <views:CompareView />
            </TabItem>

            <TabItem Header="{DynamicResource Ui_Settings}">
                <views:SettingsView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>




