<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Palette: deep navy surfaces, one blue accent, semantic status colors. -->
        <SolidColorBrush x:Key="WindowBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0D1628" />
        <SolidColorBrush x:Key="PanelBrush" Color="#101A2D" />
        <SolidColorBrush x:Key="PanelStrongBrush" Color="#14213A" />
        <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0C1526" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#1E2C45" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A9AB5" />
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#6F7F9A" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#56657F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#60A5FA" />
        <SolidColorBrush x:Key="GoodBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="BadBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#15233D" />
        <SolidColorBrush x:Key="ItemSelectedBrush" Color="#17345F" />
        <SolidColorBrush x:Key="ItemSelectedBorderBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="TabHoverBrush" Color="#13203A" />
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#17345F" />

        <!-- Metric accents shared by live tiles, the timeline, tables and system meters. -->
        <SolidColorBrush x:Key="CpuAccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="RamAccentBrush" Color="#22D3EE" />
        <SolidColorBrush x:Key="GpuAccentBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="DiskAccentBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="CpuFillBrush" Color="#333B82F6" />
        <SolidColorBrush x:Key="RamFillBrush" Color="#3322D3EE" />
        <SolidColorBrush x:Key="GpuFillBrush" Color="#33A855F7" />
        <SolidColorBrush x:Key="DiskFillBrush" Color="#3322C55E" />

