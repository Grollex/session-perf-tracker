                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui_Exe}" Width="150" DisplayMemberBinding="{Binding ExeName}" />
                                <GridViewColumn Header="{DynamicResource Ui_PathStatus}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tracking.StatusText}"
                                                       ToolTip="{Binding Tracking.TooltipText}"
                                                       TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="present">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="relocated">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="missing">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
