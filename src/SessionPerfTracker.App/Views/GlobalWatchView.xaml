<UserControl x:Class="SessionPerfTracker.App.Views.GlobalWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SessionPerfTracker.App.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SessionPerfTracker.App;component/Themes/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <controls:HeatBrushConverter x:Key="HeatBrush" />
            <controls:RowNumberConverter x:Key="RowNumber" />
            <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <Style x:Key="CardIcon" TargetType="controls:IconGlyph">
                <Setter Property="Width" Value="19" />
                <Setter Property="Height" Value="19" />
                <Setter Property="Margin" Value="0,0,9,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Brush" Value="{StaticResource AccentTextBrush}" />
            </Style>

            <Style x:Key="HeatCell" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="RecommendationExpander" TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              HorizontalContentAlignment="Stretch"
                                              Focusable="False"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid x:Name="HeaderRoot"
                                                  MinHeight="34"
                                                  Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="GlyphFrame"
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="#14213A"
                                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1">
                                                    <Path x:Name="Glyph"
                                                          Data="M 5 6 L 8 9 L 11 6"
                                                          Stroke="{StaticResource TextBrush}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Border>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderRoot" Property="Background" Value="#15233D" />
                                                    <Setter TargetName="GlyphFrame" Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Glyph" Property="Data" Value="M 5 10 L 8 7 L 11 10" />
                                                    <Setter TargetName="GlyphFrame" Property="Background" Value="#13203A" />
                                                    <Setter TargetName="GlyphFrame" Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  ContentSource="Content"
                                                  Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
<TabControl Margin="16,0,16,0"
            Style="{StaticResource PillTabControl}"
            SelectedIndex="{Binding SelectedGlobalWatchSectionIndex, Mode=TwoWay}"
            ItemContainerStyle="{StaticResource PillTabItem}">
    <TabItem Header="{DynamicResource Ui_Overview}">
        <ScrollViewer x:Name="OverviewScroll"
                      Style="{StaticResource PageScrollViewer}"
                      SizeChanged="OverviewScroll_SizeChanged">
            <Grid x:Name="OverviewRoot" MinHeight="780">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <!-- Toolbar. -->
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding GlobalWatchFilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     MinHeight="36"
                                     Padding="34,6,8,6"
                                     VerticalContentAlignment="Center" />
                            <controls:IconGlyph Data="{StaticResource IconSearch}"
                                                Brush="{StaticResource PlaceholderBrush}"
                                                Width="16"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                Margin="12,0,0,0"
                                                IsHitTestVisible="False" />
                            <TextBlock Text="{DynamicResource Ui_GwSearchPlaceholder}"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource PlaceholderBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="36,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlobalWatchFilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding GlobalWatchModes}"
                                  SelectedItem="{Binding SelectedGlobalWatchMode}"
                                  Width="160"
                                  MinHeight="36"
                                  Margin="10,0,0,0" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding GlobalWatchStateFilterOptions}"
                                  SelectedIndex="{Binding SelectedGlobalWatchStateFilterIndex}"
                                  Width="170"
                                  MinHeight="36"
                                  Margin="10,0,0,0" />
                        <Button Grid.Column="3" Click="RefreshGlobalWatch_Click" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconGlyph Data="{StaticResource IconRefresh}" Brush="{StaticResource AccentTextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Ui_GwRefreshScan}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <CheckBox Grid.Column="4"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding GlobalWatchAutoRefresh}"
                                  VerticalAlignment="Center"
                                  Margin="18,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui_GwAutoRefresh}" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding GlobalWatchAutoRefreshText}" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Grid.Column="5"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding GlobalWatchOnlySuspicious}"
                                  Content="{DynamicResource Ui_GwSuspiciousOnly}"
                                  VerticalAlignment="Center"
                                  Margin="18,0,0,0" />
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="18,0,4,0" MaxWidth="220">
                            <TextBlock Text="{DynamicResource Ui_GwLastScan}" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding GlobalWatchLastScanShortText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding GlobalWatchLastScanText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Process table. -->
                    <Border Style="{StaticResource Card}" Padding="12,12,12,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="4,0,4,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Ui_GpuTemperatureShort}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SystemGpuTemperatureText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Text="{DynamicResource Ui_SystemCpu}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SystemCpuText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Text="{DynamicResource Ui_SystemRam}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding SystemRamText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconCpu}" Style="{StaticResource CardIcon}" />
                                    <TextBlock Text="{Binding GlobalWatchProcessesTitle}" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding GlobalWatchProcesses}"
                                      SelectedItem="{Binding SelectedGlobalProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="SelectionKey"
                                      IsSynchronizedWithCurrentItem="False"
                                      AlternationCount="100000"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Style="{StaticResource DataListView}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                        <Setter Property="Padding" Value="2,3" />
                                        <Setter Property="MinHeight" Value="34" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="34">
                                            <GridViewColumn.Header>
                                                <TextBlock Text="#" Style="{StaticResource MutedText}" Margin="8,6" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource RowNumber}}"
                                                               Style="{StaticResource MutedText}"
                                                               TextWrapping="NoWrap" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="174">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchProcessHeaderText}" Click="SortGlobalWatchProcess_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding DisplayName}">
                                                        <Grid Width="20" Height="20" Margin="0,0,9,0">
                                                            <controls:IconGlyph Data="{StaticResource IconMonitor}" Brush="{StaticResource DisabledTextBrush}" Width="16" Height="16" />
                                                            <controls:ExeIcon Path="{Binding IconPath}" Width="20" Height="20" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding TableNameText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="145" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="78">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchPidHeaderText}" Click="SortGlobalWatchPid_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PidOrCountText}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="70">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchCpuHeaderText}" Click="SortGlobalWatchCpu_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HeatCell}" Width="58" Background="{Binding CpuPercent, Converter={StaticResource HeatBrush}, ConverterParameter=cpu}">
                                                        <TextBlock Text="{Binding CpuText}" TextWrapping="NoWrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="70">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchGpuHeaderText}" Click="SortGlobalWatchGpu_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HeatCell}" Width="58" Background="{Binding GpuPercent, Converter={StaticResource HeatBrush}, ConverterParameter=gpu}" ToolTip="{Binding GpuMemoryText}">
                                                        <TextBlock Text="{Binding GpuText}" TextWrapping="NoWrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="86">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchRamHeaderText}" Click="SortGlobalWatchRam_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HeatCell}" Width="74" Background="{Binding MemoryMb, Converter={StaticResource HeatBrush}, ConverterParameter=ram}">
                                                        <TextBlock Text="{Binding MemoryText}" TextWrapping="NoWrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="86">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchDiskHeaderText}" Click="SortGlobalWatchDisk_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HeatCell}" Width="74" Background="{Binding DiskTotalMbPerSec, Converter={StaticResource HeatBrush}, ConverterParameter=disk}" ToolTip="{Binding DiskReadWriteText}">
                                                        <TextBlock Text="{Binding DiskTotalText}" TextWrapping="NoWrap" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="82">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchStartedHeaderText}" Click="SortGlobalWatchStarted_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StartedText}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="114">
                                            <GridViewColumn.Header>
                                                <TextBlock Text="{DynamicResource Ui_Publisher}" Style="{StaticResource MutedText}" Margin="6,6" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PublisherText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="108" ToolTip="{Binding PublisherText}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110">
                                            <GridViewColumn.Header>
                                                <Button Content="{Binding GlobalWatchHealthHeaderText}" Click="SortGlobalWatchHealth_Click" Style="{StaticResource TableHeaderSortButton}" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ProfileSourceText}">
                                                        <Ellipse Style="{StaticResource StateDot}" Tag="{Binding HealthBadgeText}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding HealthDisplayText}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border Grid.Row="1" Style="{StaticResource EmptyState}">
                                <Border.Visibility>
                                    <Binding Path="HasGlobalWatchRows" Converter="{StaticResource InverseBoolToVisibility}" />
                                </Border.Visibility>
                                <TextBlock Text="{Binding GlobalWatchEmptyStateText}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Process inspector. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer Style="{StaticResource PageScrollViewer}">
                            <StackPanel Margin="16,14,16,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <controls:IconGlyph Data="{StaticResource IconInspect}" Style="{StaticResource CardIcon}" />
                                    <TextBlock Text="{DynamicResource Ui_ProcessInspector}" Style="{StaticResource CardTitle}" />
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="10"
                                            Background="{StaticResource PanelStrongBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            Margin="0,0,12,0">
                                        <Grid>
                                            <controls:IconGlyph Data="{StaticResource IconMonitor}" Brush="{StaticResource MutedBrush}" Width="22" Height="22" />
                                            <controls:ExeIcon Path="{Binding SelectedGlobalProcessIconPath}" Width="30" Height="30" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGlobalProcessNameText}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedGlobalProcessTitle}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Style="{StaticResource StateDot}" Tag="{Binding SelectedGlobalProcessHealthTag}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedGlobalProcessHealthDisplayText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding SelectedGlobalProcessSubtitleText}"
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Text="{DynamicResource Ui_Path}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedGlobalProcessPathText}"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               ToolTip="{Binding SelectedGlobalProcessPathText}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            MinHeight="26"
                                            MinWidth="26"
                                            VerticalAlignment="Top"
                                            Margin="6,0,0,0"
                                            Click="CopyGlobalProcessPath_Click"
                                            IsEnabled="{Binding CanCopySelectedGlobalProcessPath}"
                                            ToolTip="{DynamicResource Ui_CopyPath}">
                                        <controls:IconGlyph Data="{StaticResource IconCopy}" Brush="{StaticResource TextBrush}" Width="14" Height="14" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Text="{DynamicResource Ui_Company}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessCompanyText}" ToolTip="{Binding SelectedGlobalProcessCompanyText}" />
                                    <TextBlock Grid.Row="2" Text="{DynamicResource Ui_Product}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessProductText}" ToolTip="{Binding SelectedGlobalProcessProductText}" />
                                    <TextBlock Grid.Row="3" Text="{DynamicResource Ui_Signer}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessSignerText}" TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding SelectedGlobalProcessSignerText}" />
                                    <TextBlock Grid.Row="4" Text="{DynamicResource Ui_Parent}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessParentText}" />
                                    <TextBlock Grid.Row="5" Text="{DynamicResource Ui_FieldChildProcesses}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessChildCountText}" />
                                    <TextBlock Grid.Row="6" Text="{DynamicResource Ui_SummaryStart}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessStartedText}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="7" Text="{DynamicResource Ui_Profile}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessProfileText}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="8" Text="{DynamicResource Ui_Reason}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedGlobalProcessReasonText}" TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Text="{DynamicResource Ui_ResourceUsageLive}" Style="{StaticResource CardTitle}" FontSize="13" Margin="0,10,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>
                                    <controls:IconGlyph Data="{StaticResource IconCpu}" Brush="{StaticResource CpuAccentBrush}" Width="17" Height="17" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Ui_CPU}" VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Column="2" Style="{StaticResource ThinMeter}" Height="6" Value="{Binding SelectedGlobalProcessCpuPercent, Mode=OneWay}" Foreground="{StaticResource CpuAccentBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SelectedGlobalProcessCpuText}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0" MinWidth="64" TextAlignment="Right" />

                                    <controls:IconGlyph Grid.Row="1" Data="{StaticResource IconGpu}" Brush="{StaticResource GpuAccentBrush}" Width="17" Height="17" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Ui_GpuShort}" VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Row="1" Grid.Column="2" Style="{StaticResource ThinMeter}" Height="6" Value="{Binding SelectedGlobalProcessGpuPercent, Mode=OneWay}" Foreground="{StaticResource GpuAccentBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedGlobalProcessGpuText}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0" MinWidth="64" TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="110" />

                                    <controls:IconGlyph Grid.Row="2" Data="{StaticResource IconRam}" Brush="{StaticResource RamAccentBrush}" Width="17" Height="17" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Ui_RAM}" VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Row="2" Grid.Column="2" Style="{StaticResource ThinMeter}" Height="6" Value="{Binding SelectedGlobalProcessRamPercent, Mode=OneWay}" Foreground="{StaticResource RamAccentBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedGlobalProcessRamShareText}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0" MinWidth="64" TextAlignment="Right" />

                                    <controls:IconGlyph Grid.Row="3" Data="{StaticResource IconDisk}" Brush="{StaticResource DiskAccentBrush}" Width="17" Height="17" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Ui_Disk}" VerticalAlignment="Center" FontSize="12" />
                                    <ProgressBar Grid.Row="3" Grid.Column="2" Style="{StaticResource ThinMeter}" Height="6" Value="{Binding SelectedGlobalProcessDiskPercent, Mode=OneWay}" Foreground="{StaticResource DiskAccentBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedGlobalProcessDiskText}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0" MinWidth="64" TextAlignment="Right" />
                                </Grid>

                                <TextBlock Text="{DynamicResource Ui_Actions}" Style="{StaticResource CardTitle}" FontSize="13" Margin="0,14,0,10" />
                                <UniformGrid Columns="2">
                                    <Button Click="OpenGlobalProcessInspector_Click" IsEnabled="{Binding CanInspectSelectedGlobalProcess}" Margin="0,0,6,8">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconGlyph Data="{StaticResource IconInspect}" Brush="{StaticResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Ui_Inspect}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MonitorGlobalProcess_Click" IsEnabled="{Binding CanMonitorSelectedGlobalProcess}" Style="{StaticResource AccentButton}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconGlyph Data="{StaticResource IconPulse}" Brush="{StaticResource AccentTextBrush}" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Ui_TrackSession}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenGlobalProcessLocation_Click" IsEnabled="{Binding CanOpenSelectedGlobalProcessFileLocation}" Style="{StaticResource CompactButton}" Margin="0,0,6,8">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconGlyph Data="{StaticResource IconFolder}" Brush="{StaticResource TextBrush}" Width="15" Height="15" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Ui_OpenFileLocation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenRecommendationsForGlobalWatch_Click" IsEnabled="{Binding SelectedGlobalProcessHasRecommendation}" Style="{StaticResource CompactButton}" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource Ui_OpenRecommendations}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Click="KillGlobalProcess_Click" IsEnabled="{Binding CanKillSelectedGlobalProcess}" Style="{StaticResource DangerButton}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconGlyph Data="{StaticResource IconKill}" Brush="#FCA5A5" Width="15" Height="15" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Ui_KillPid}" Foreground="#FCA5A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="KillGlobalProcessTree_Click" IsEnabled="{Binding CanKillSelectedGlobalProcess}" Style="{StaticResource DangerButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconGlyph Data="{StaticResource IconTree}" Brush="#FCA5A5" Width="15" Height="15" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding SelectedGlobalProcessKillTreeLabel}" Foreground="#FCA5A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <Expander Header="{DynamicResource Ui_GwMoreActions}" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Ui_Profile}" Style="{StaticResource MutedText}" />
                                        <DockPanel Margin="0,2,0,0">
                                            <Button DockPanel.Dock="Right"
                                                    Content="{DynamicResource Ui_Assign}"
                                                    Click="AssignGlobalWatchProfile_Click"
                                                    IsEnabled="{Binding CanAssignSelectedGlobalProcessProfile}"
                                                    Style="{StaticResource CompactButton}"
                                                    Margin="8,6,0,0" />
                                            <ComboBox ItemsSource="{Binding ThresholdProfiles}"
                                                      SelectedItem="{Binding SelectedLiveAssignmentProfile}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding CanAssignSelectedGlobalProcessProfile}" />
                                        </DockPanel>

                                        <TextBlock Text="{DynamicResource Ui_SuspiciousWatchlist}" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding SelectedGlobalProcessSuspiciousText}" FontSize="12" Margin="0,2,0,0" />
                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                            <Button Content="{DynamicResource Ui_Mark}"
                                                    Click="MarkGlobalWatchSuspicious_Click"
                                                    IsEnabled="{Binding CanMarkSelectedGlobalProcessSuspicious}"
                                                    Style="{StaticResource CompactButton}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="{DynamicResource Ui_Remove}"
                                                    Click="RemoveGlobalWatchSuspicious_Click"
                                                    IsEnabled="{Binding CanRemoveSelectedGlobalProcessSuspicious}"
                                                    Style="{StaticResource TertiaryButton}" />
                                        </UniformGrid>

                                        <TextBlock Text="{DynamicResource Ui_Bans}" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding SelectedGlobalProcessBanText}" FontSize="12" Margin="0,2,0,0" />
                                        <ComboBox ItemsSource="{Binding ProcessBanDurationOptions}"
                                                  SelectedItem="{Binding SelectedProcessBanDurationOption}"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{Binding CanBanSelectedGlobalProcess}" />
                                        <UniformGrid Columns="2" Margin="0,8,0,0">
                                            <Button Content="{DynamicResource Ui_Ban}"
                                                    Click="BanGlobalProcess_Click"
                                                    IsEnabled="{Binding CanBanSelectedGlobalProcess}"
                                                    Style="{StaticResource DangerButton}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="{DynamicResource Ui_BanKill}"
                                                    Click="BanAndKillGlobalProcess_Click"
                                                    IsEnabled="{Binding CanBanSelectedGlobalProcess}"
                                                    Style="{StaticResource DangerButton}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Text="{Binding GlobalWatchStatusText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Summary panels. -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding TopConsumerOptions}"
                                          SelectedIndex="{Binding SelectedTopConsumerIndex}"
                                          Width="130"
                                          MinHeight="28"
                                          Margin="0" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconTrophy}" Style="{StaticResource CardIcon}" Brush="{StaticResource WarnBrush}" />
                                    <TextBlock Text="{DynamicResource Ui_GwTopConsumers}" Style="{StaticResource CardTitle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TopConsumers}" AlternationCount="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource RowNumber}}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <controls:ExeIcon Path="{Binding IconPath}" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding TableNameText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource HeatCell}" VerticalAlignment="Center" Background="{Binding CpuPercent, Converter={StaticResource HeatBrush}, ConverterParameter=cpu}">
                                                <TextBlock Text="{Binding CpuText}" FontSize="12" TextWrapping="NoWrap" />
                                            </Border>
                                            <Border Grid.Column="3" Style="{StaticResource HeatCell}" VerticalAlignment="Center" Background="{Binding GpuPercent, Converter={StaticResource HeatBrush}, ConverterParameter=gpu}">
                                                <TextBlock Text="{Binding GpuText}" FontSize="12" TextWrapping="NoWrap" />
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource HeatCell}" VerticalAlignment="Center" Background="{Binding MemoryMb, Converter={StaticResource HeatBrush}, ConverterParameter=ram}">
                                                <TextBlock Text="{Binding MemoryText}" FontSize="12" TextWrapping="NoWrap" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{DynamicResource Ui_ViewAll}" Click="ShowNewestGlobalProcesses_Click" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconClock}" Style="{StaticResource CardIcon}" />
                                    <TextBlock Text="{DynamicResource Ui_GwRecentlyStarted}" Style="{StaticResource CardTitle}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding RecentlyStartedProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:ExeIcon Path="{Binding IconPath}" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding TableNameText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding FullPath}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ProcessIdText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding StartedText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{DynamicResource Ui_ViewAll}" Click="OpenWatchJournal_Click" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconAlert}" Style="{StaticResource CardIcon}" Brush="{StaticResource BadBrush}" />
                                    <TextBlock Text="{DynamicResource Ui_GwWatchAlerts}" Style="{StaticResource CardTitle}" FontSize="14" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding RecentWatchAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SeverityBadge}" Tag="{Binding SeverityTag}" Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0">
                                                <controls:IconGlyph Brush="White" Width="12" Height="12" StrokeWeight="2.8">
                                                    <controls:IconGlyph.Style>
                                                        <Style TargetType="controls:IconGlyph">
                                                            <Setter Property="Data" Value="{StaticResource IconExclaim}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SeverityTag}" Value="Info">
                                                                    <Setter Property="Data" Value="{StaticResource IconInfoMark}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:IconGlyph.Style>
                                                </controls:IconGlyph>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding IdentityText}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding AlertText}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" ToolTip="{Binding AlertText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Ui_GwNoAlerts}"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasGlobalWatchJournalEntries, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </TabItem>

    <TabItem Header="{DynamicResource Ui_Journal}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Ui_WatchJournal}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GlobalWatchJournalStatusText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource Ui_GroupedJournalHint}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Visibility="{Binding HasGlobalWatchJournalGroups, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding GlobalWatchJournalGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,10"
                                              Padding="0"
                                              Foreground="{StaticResource TextBrush}">
                                        <Expander.Header>
                                            <Grid Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IdentityText}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding IdentityText}"
                                                                   MaxWidth="320" />
                                                        <Border Padding="7,2"
                                                                Margin="10,0,0,0"
                                                                CornerRadius="7"
                                                                Background="#14213A"
                                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding CountText}" FontSize="11" />
                                                        </Border>
                                                        <Border Padding="7,2"
                                                                Margin="6,0,0,0"
                                                                CornerRadius="7"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#0F2E1E" />
                                                                    <Setter Property="BorderBrush" Value="#22A35A" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Near">
                                                                            <Setter Property="Background" Value="#2A2512" />
                                                                            <Setter Property="BorderBrush" Value="#A88423" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Over">
                                                                            <Setter Property="Background" Value="#2A1F14" />
                                                                            <Setter Property="BorderBrush" Value="#B66D2A" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Critical">
                                                                            <Setter Property="Background" Value="#2A1219" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Recommendation">
                                                                            <Setter Property="Background" Value="#13203A" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding HealthText}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Reason}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding MetricsText}"
                                                               Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MetricsText}" />
                                                    <TextBlock Text="{Binding PathText}"
                                                               Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding PathText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Top">
                                                    <Button Content="{DynamicResource Ui_Overview}"
                                                            Click="SelectJournalTarget_Click"
                                                            Style="{StaticResource CompactButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_ViewDetails}"
                                                            Click="InspectJournalTarget_Click"
                                                            Style="{StaticResource CompactButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_Suspicious}"
                                                            Click="MarkJournalSuspicious_Click"
                                                            Style="{StaticResource CompactButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <ComboBox ItemsSource="{Binding DataContext.ProcessBanDurationOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding DataContext.SelectedProcessBanDurationOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                              DisplayMemberPath="Label"
                                                              Width="104"
                                                              MinHeight="26"
                                                              Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_Ban}"
                                                            Click="BanJournalTarget_Click"
                                                            Style="{StaticResource DangerButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_BanKill}"
                                                            Click="BanAndKillJournalTarget_Click"
                                                            Style="{StaticResource DangerButton}"
                                                            MinHeight="26"
                                                            Padding="8,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ListView ItemsSource="{Binding Entries}"
                                                  MaxHeight="220"
                                                  Background="#0C1526"
                                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="{DynamicResource Ui_Time}" Width="72" DisplayMemberBinding="{Binding TimestampText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Mode}" Width="96" DisplayMemberBinding="{Binding ModeText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Profile}" Width="170" DisplayMemberBinding="{Binding ProfileText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Metrics}" Width="300" DisplayMemberBinding="{Binding MetricsText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Path}" Width="300">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding PathText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding PathText}" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="{DynamicResource Ui_Reason}" Width="360">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Reason}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Reason}" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Padding="18"
                            CornerRadius="8"
                            Background="#0C1526"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGlobalWatchJournalGroups}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoWatchStates}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </TabItem>

            <TabItem Header="{DynamicResource Ui_Recommendations}">
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Ui_ProfileRecommendations}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Ui_RecommendationHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="{DynamicResource Ui_Promote}"
                            Click="PromoteRecommendation_Click"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="30"
                            Padding="10,0"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Ui_PromoteSelected}"
                            Click="PromoteSelectedRecommendations_Click"
                            Style="{StaticResource CompactButton}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Ui_IgnoreSelected}"
                            Click="DenySelectedRecommendations_Click"
                            Style="{StaticResource TertiaryButton}" />
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="2"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0">
                <TextBlock Text="{DynamicResource Ui_TargetActions}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0" />
                <Button Content="{DynamicResource Ui_Overview}"
                        Click="SelectRecommendationTarget_Click"
                        Style="{StaticResource CompactButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_ViewDetails}"
                        Click="InspectRecommendationTarget_Click"
                        Style="{StaticResource CompactButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_MarkSuspicious}"
                        Click="MarkRecommendationSuspicious_Click"
                        Style="{StaticResource CompactButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <ComboBox ItemsSource="{Binding ProcessBanDurationOptions}"
                          SelectedItem="{Binding SelectedProcessBanDurationOption}"
                          DisplayMemberPath="Label"
                          Width="112"
                          MinHeight="28"
                          Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_Ban}"
                        Click="BanRecommendationTarget_Click"
                        Style="{StaticResource DangerButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
