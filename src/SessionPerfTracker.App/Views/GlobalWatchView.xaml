<UserControl x:Class="SessionPerfTracker.App.Views.GlobalWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SessionPerfTracker.App;component/Themes/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RecommendationExpander" TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              HorizontalContentAlignment="Stretch"
                                              Focusable="False"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid x:Name="HeaderRoot"
                                                  MinHeight="34"
                                                  Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="GlyphFrame"
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="#17232A"
                                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1">
                                                    <Path x:Name="Glyph"
                                                          Data="M 5 6 L 8 9 L 11 6"
                                                          Stroke="{StaticResource TextBrush}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Border>
                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderRoot" Property="Background" Value="#172029" />
                                                    <Setter TargetName="GlyphFrame" Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Glyph" Property="Data" Value="M 5 10 L 8 7 L 11 10" />
                                                    <Setter TargetName="GlyphFrame" Property="Background" Value="#14202A" />
                                                    <Setter TargetName="GlyphFrame" Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  ContentSource="Content"
                                                  Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
<TabControl Margin="16,0,0,0"
            TabStripPlacement="Top"
            Style="{StaticResource SubTabControl}"
            Padding="0"
            SelectedIndex="{Binding SelectedGlobalWatchSectionIndex, Mode=TwoWay}"
            ItemContainerStyle="{StaticResource SubTabItem}">
    <TabItem Header="{DynamicResource Ui_Overview}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Whole-system load. -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_SystemCpu}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemCpuText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemCpuPercent, Mode=OneWay}" Foreground="{StaticResource CpuAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_SystemRam}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemRamText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemRamPercent, Mode=OneWay}" Foreground="{StaticResource RamAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" ToolTip="{Binding SystemGpuNameText}">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_GpuShort}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemGpuText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemGpuPercent, Mode=OneWay}" Foreground="{StaticResource GpuAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" ToolTip="{Binding SystemGpuNameText}">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_VramShort}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemVramText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemVramPercent, Mode=OneWay}" Foreground="{StaticResource GpuAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="8" VerticalAlignment="Center" MinWidth="170">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Ui_GpuTemperatureShort}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SystemGpuTemperatureText}" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="0,0,14,0" />
                            <TextBlock Text="{DynamicResource Ui_ProcessesShort}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SystemProcessCountText}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding GlobalWatchLastScanText}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   TextWrapping="NoWrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar: search, mode, filter chips. -->
            <Border Grid.Row="2" Style="{StaticResource ToolbarPanel}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding GlobalWatchFilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 MinHeight="30" />
                        <TextBlock Text="{DynamicResource Ui_SearchProcessName}"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GlobalWatchFilterText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding GlobalWatchModes}"
                              SelectedItem="{Binding SelectedGlobalWatchMode}"
                              Width="170"
                              Margin="0" />
                    <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                        <CheckBox Content="{DynamicResource Ui_OnlyOverLimit}" IsChecked="{Binding GlobalWatchOnlyOverLimit}" Style="{StaticResource ChipToggle}" />
                        <CheckBox Content="{DynamicResource Ui_OnlyCritical}" IsChecked="{Binding GlobalWatchOnlyCritical}" Style="{StaticResource ChipToggle}" />
                        <CheckBox Content="{DynamicResource Ui_OnlyNearLimit}" IsChecked="{Binding GlobalWatchOnlyNearLimit}" Style="{StaticResource ChipToggle}" />
                        <CheckBox Content="{DynamicResource Ui_OnlyUnassigned}" IsChecked="{Binding GlobalWatchOnlyUnassigned}" Style="{StaticResource ChipToggle}" />
                    </WrapPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GlobalWatchRowCountText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Refresh}"
                                Click="RefreshGlobalWatch_Click"
                                Style="{StaticResource ToolbarButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top consumers in the current scan. -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui_TopCpu}" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding TopCpuOffenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TopCpuText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopCpuText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Ui_TopRam}" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding TopRamOffenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TopRamText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopRamText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Ui_TopGpu}" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding TopGpuOffenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TopGpuText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopGpuText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="{DynamicResource Ui_TopDisk}" Style="{StaticResource MetricLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding TopDiskOffenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TopDiskText}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TopDiskText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding GlobalWatchProcesses}"
                                  SelectedItem="{Binding SelectedGlobalProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="SelectionKey"
                                  IsSynchronizedWithCurrentItem="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Style="{StaticResource DataListView}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="204">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchProcessHeaderText}"
                                                    Click="SortGlobalWatchProcess_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="72" DisplayMemberBinding="{Binding PidOrCountText}">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchPidHeaderText}"
                                                    Click="SortGlobalWatchPid_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="82">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchCpuHeaderText}"
                                                    Click="SortGlobalWatchCpu_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="64">
                                                    <TextBlock Text="{Binding CpuText}" TextWrapping="NoWrap" />
                                                    <ProgressBar Style="{StaticResource ThinMeter}"
                                                                 Height="3"
                                                                 Margin="0,2,0,0"
                                                                 Foreground="{StaticResource CpuAccentBrush}"
                                                                 Value="{Binding CpuPercent, Mode=OneWay, TargetNullValue=0, FallbackValue=0}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="94" DisplayMemberBinding="{Binding MemoryText}">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchRamHeaderText}"
                                                    Click="SortGlobalWatchRam_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="84">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchGpuHeaderText}"
                                                    Click="SortGlobalWatchGpu_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="66" ToolTip="{Binding GpuMemoryText}">
                                                    <TextBlock Text="{Binding GpuText}" TextWrapping="NoWrap" />
                                                    <ProgressBar Style="{StaticResource ThinMeter}"
                                                                 Height="3"
                                                                 Margin="0,2,0,0"
                                                                 Foreground="{StaticResource GpuAccentBrush}"
                                                                 Value="{Binding GpuPercent, Mode=OneWay, TargetNullValue=0, FallbackValue=0}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="88" DisplayMemberBinding="{Binding DiskTotalText}">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchDiskHeaderText}"
                                                    Click="SortGlobalWatchDisk_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="84">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchProfileHeaderText}"
                                                    Click="SortGlobalWatchProfile_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,1"
                                                        CornerRadius="8"
                                                        Background="#18222E"
                                                        BorderBrush="#2E4258"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ProfileBadgeText}"
                                                               FontSize="11"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80">
                                        <GridViewColumn.Header>
                                            <Button Content="{Binding GlobalWatchHealthHeaderText}"
                                                    Click="SortGlobalWatchHealth_Click"
                                                    Style="{StaticResource TableHeaderSortButton}" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,1"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#11261D" />
                                                            <Setter Property="BorderBrush" Value="#24664B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthBadgeText}" Value="Near">
                                                                    <Setter Property="Background" Value="#2A2210" />
                                                                    <Setter Property="BorderBrush" Value="#8A6A1C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HealthBadgeText}" Value="Over">
                                                                    <Setter Property="Background" Value="#2B1D12" />
                                                                    <Setter Property="BorderBrush" Value="#A3622A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HealthBadgeText}" Value="Critical">
                                                                    <Setter Property="Background" Value="#2A1618" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding HealthDisplayText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="NoWrap" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Border Grid.Row="2" Style="{StaticResource EmptyState}">
                            <Border.Visibility>
                                <Binding Path="HasGlobalWatchRows">
                                    <Binding.Converter>
                                        <local:InverseBoolToVisibilityConverter xmlns:local="clr-namespace:SessionPerfTracker.App.Controls" />
                                    </Binding.Converter>
                                </Binding>
                            </Border.Visibility>
                            <TextBlock Text="{Binding GlobalWatchEmptyStateText}"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Selected row: identity, numbers and actions. -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedGlobalProcessPanelTitle}" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding SelectedGlobalProcessTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="44"
                                       Margin="0,4,0,0"
                                       ToolTip="{Binding SelectedGlobalProcessTitle}" />
                            <TextBlock Text="{Binding SelectedGlobalProcessHint}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui_CPU}" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding SelectedGlobalProcessCpuText}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui_RAM}" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding SelectedGlobalProcessRamText}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui_GpuShort}" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding SelectedGlobalProcessGpuText}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui_Disk}" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding SelectedGlobalProcessDiskText}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Margin" Value="0,0,0,7" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Text="{DynamicResource Ui_Product}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedGlobalProcessProductText}" ToolTip="{Binding SelectedGlobalProcessProductText}" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource Ui_Company}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGlobalProcessCompanyText}" ToolTip="{Binding SelectedGlobalProcessCompanyText}" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource Ui_Signer}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGlobalProcessSignerText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="{DynamicResource Ui_Path}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{Binding SelectedGlobalProcessPathText}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="46"
                                           ToolTip="{Binding SelectedGlobalProcessPathText}" />
                                <TextBlock Grid.Row="4" Text="{DynamicResource Ui_Parent}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGlobalProcessParentText}" />
                                <TextBlock Grid.Row="5" Text="{DynamicResource Ui_Tree}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedGlobalProcessDescendantsText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="6" Text="{DynamicResource Ui_Profile}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedGlobalProcessProfileText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="7" Text="{DynamicResource Ui_Reason}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedGlobalProcessReasonText}" TextWrapping="Wrap" />
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Content="{DynamicResource Ui_CopyPath}"
                                        Click="CopyGlobalProcessPath_Click"
                                        IsEnabled="{Binding CanCopySelectedGlobalProcessPath}"
                                        Style="{StaticResource TertiaryButton}"
                                        Margin="0,0,6,0" />
                                <Button Content="{DynamicResource Ui_OpenFileLocation}"
                                        Click="OpenGlobalProcessLocation_Click"
                                        IsEnabled="{Binding CanOpenSelectedGlobalProcessFileLocation}"
                                        Style="{StaticResource TertiaryButton}" />
                            </UniformGrid>

                            <TextBlock Text="{DynamicResource Ui_Actions}" Style="{StaticResource MetricLabel}" Margin="0,16,0,6" />
                            <Button Content="{DynamicResource Ui_MonitorProcessGroup}"
                                    Click="MonitorGlobalProcess_Click"
                                    IsEnabled="{Binding CanMonitorSelectedGlobalProcess}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Content="{DynamicResource Ui_ViewDetails}"
                                    Click="OpenGlobalProcessInspector_Click"
                                    IsEnabled="{Binding CanInspectSelectedGlobalProcess}"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,8,0,0" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{DynamicResource Ui_Assign}"
                                        Click="AssignGlobalWatchProfile_Click"
                                        IsEnabled="{Binding CanAssignSelectedGlobalProcessProfile}"
                                        Style="{StaticResource CompactButton}"
                                        Margin="8,6,0,0" />
                                <ComboBox ItemsSource="{Binding ThresholdProfiles}"
                                          SelectedItem="{Binding SelectedLiveAssignmentProfile}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding CanAssignSelectedGlobalProcessProfile}" />
                            </DockPanel>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="{StaticResource SurfaceSunkenBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Ui_SuspiciousWatchlist}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedGlobalProcessSuspiciousText}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button Content="{DynamicResource Ui_Mark}"
                                                Click="MarkGlobalWatchSuspicious_Click"
                                                IsEnabled="{Binding CanMarkSelectedGlobalProcessSuspicious}"
                                                Style="{StaticResource CompactButton}"
                                                Margin="0,0,6,0" />
                                        <Button Content="{DynamicResource Ui_Remove}"
                                                Click="RemoveGlobalWatchSuspicious_Click"
                                                IsEnabled="{Binding CanRemoveSelectedGlobalProcessSuspicious}"
                                                Style="{StaticResource TertiaryButton}" />
                                    </UniformGrid>
                                    <Button Content="{DynamicResource Ui_OpenRecommendations}"
                                            Click="OpenRecommendationsForGlobalWatch_Click"
                                            IsEnabled="{Binding SelectedGlobalProcessHasRecommendation}"
                                            Style="{StaticResource TertiaryButton}"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DangerPanel}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Ui_DangerZone}" FontWeight="SemiBold" Foreground="{StaticResource BadBrush}" />
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button Content="{DynamicResource Ui_KillPid}"
                                                Click="KillGlobalProcess_Click"
                                                IsEnabled="{Binding CanKillSelectedGlobalProcess}"
                                                Style="{StaticResource DangerButton}"
                                                Margin="0,0,6,0" />
                                        <Button Content="{Binding SelectedGlobalProcessKillTreeLabel}"
                                                Click="KillGlobalProcessTree_Click"
                                                IsEnabled="{Binding CanKillSelectedGlobalProcess}"
                                                Style="{StaticResource DangerButton}" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SelectedGlobalProcessBanText}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                    <ComboBox ItemsSource="{Binding ProcessBanDurationOptions}"
                                              SelectedItem="{Binding SelectedProcessBanDurationOption}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding CanBanSelectedGlobalProcess}" />
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button Content="{DynamicResource Ui_Ban}"
                                                Click="BanGlobalProcess_Click"
                                                IsEnabled="{Binding CanBanSelectedGlobalProcess}"
                                                Style="{StaticResource DangerButton}"
                                                Margin="0,0,6,0" />
                                        <Button Content="{DynamicResource Ui_BanKill}"
                                                Click="BanAndKillGlobalProcess_Click"
                                                IsEnabled="{Binding CanBanSelectedGlobalProcess}"
                                                Style="{StaticResource DangerButton}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding GlobalWatchStatusText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </TabItem>

    <TabItem Header="{DynamicResource Ui_Journal}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Ui_WatchJournal}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GlobalWatchJournalStatusText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource Ui_GroupedJournalHint}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Visibility="{Binding HasGlobalWatchJournalGroups, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding GlobalWatchJournalGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,10"
                                              Padding="0"
                                              Foreground="{StaticResource TextBrush}">
                                        <Expander.Header>
                                            <Grid Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IdentityText}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding IdentityText}"
                                                                   MaxWidth="320" />
                                                        <Border Padding="7,2"
                                                                Margin="10,0,0,0"
                                                                CornerRadius="7"
                                                                Background="#17232A"
                                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding CountText}" FontSize="11" />
                                                        </Border>
                                                        <Border Padding="7,2"
                                                                Margin="6,0,0,0"
                                                                CornerRadius="7"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#142A1D" />
                                                                    <Setter Property="BorderBrush" Value="#2E8D62" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Near">
                                                                            <Setter Property="Background" Value="#2A2512" />
                                                                            <Setter Property="BorderBrush" Value="#A88423" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Over">
                                                                            <Setter Property="Background" Value="#2A1F14" />
                                                                            <Setter Property="BorderBrush" Value="#B66D2A" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Critical">
                                                                            <Setter Property="Background" Value="#2B1719" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HealthText}" Value="Recommendation">
                                                                            <Setter Property="Background" Value="#14202A" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding HealthText}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Reason}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding MetricsText}"
                                                               Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding MetricsText}" />
                                                    <TextBlock Text="{Binding PathText}"
                                                               Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding PathText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Top">
                                                    <Button Content="{DynamicResource Ui_Overview}"
                                                            Click="SelectJournalTarget_Click"
                                                            Style="{StaticResource CompactButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_ViewDetails}"
                                                            Click="InspectJournalTarget_Click"
                                                            Style="{StaticResource CompactButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_Suspicious}"
                                                            Click="MarkJournalSuspicious_Click"
                                                            Style="{StaticResource CompactButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <ComboBox ItemsSource="{Binding DataContext.ProcessBanDurationOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding DataContext.SelectedProcessBanDurationOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                              DisplayMemberPath="Label"
                                                              Width="104"
                                                              MinHeight="26"
                                                              Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_Ban}"
                                                            Click="BanJournalTarget_Click"
                                                            Style="{StaticResource DangerButton}"
                                                            MinHeight="26"
                                                            Padding="8,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Ui_BanKill}"
                                                            Click="BanAndKillJournalTarget_Click"
                                                            Style="{StaticResource DangerButton}"
                                                            MinHeight="26"
                                                            Padding="8,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ListView ItemsSource="{Binding Entries}"
                                                  MaxHeight="220"
                                                  Background="#11151B"
                                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                                  Foreground="{StaticResource TextBrush}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="{DynamicResource Ui_Time}" Width="72" DisplayMemberBinding="{Binding TimestampText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Mode}" Width="96" DisplayMemberBinding="{Binding ModeText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Profile}" Width="170" DisplayMemberBinding="{Binding ProfileText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Metrics}" Width="300" DisplayMemberBinding="{Binding MetricsText}" />
                                                    <GridViewColumn Header="{DynamicResource Ui_Path}" Width="300">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding PathText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding PathText}" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="{DynamicResource Ui_Reason}" Width="360">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Reason}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Reason}" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Padding="18"
                            CornerRadius="8"
                            Background="#11151B"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGlobalWatchJournalGroups}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoWatchStates}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </TabItem>

            <TabItem Header="{DynamicResource Ui_Recommendations}">
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Ui_ProfileRecommendations}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Ui_RecommendationHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="{DynamicResource Ui_Promote}"
                            Click="PromoteRecommendation_Click"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="30"
                            Padding="10,0"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Ui_PromoteSelected}"
                            Click="PromoteSelectedRecommendations_Click"
                            Style="{StaticResource CompactButton}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Ui_IgnoreSelected}"
                            Click="DenySelectedRecommendations_Click"
                            Style="{StaticResource TertiaryButton}" />
                </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="2"
                       VerticalAlignment="Center"
                       Margin="0,0,0,0">
                <TextBlock Text="{DynamicResource Ui_TargetActions}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0" />
                <Button Content="{DynamicResource Ui_Overview}"
                        Click="SelectRecommendationTarget_Click"
                        Style="{StaticResource CompactButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_ViewDetails}"
                        Click="InspectRecommendationTarget_Click"
                        Style="{StaticResource CompactButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_MarkSuspicious}"
                        Click="MarkRecommendationSuspicious_Click"
                        Style="{StaticResource CompactButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <ComboBox ItemsSource="{Binding ProcessBanDurationOptions}"
                          SelectedItem="{Binding SelectedProcessBanDurationOption}"
                          DisplayMemberPath="Label"
                          Width="112"
                          MinHeight="28"
                          Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_Ban}"
                        Click="BanRecommendationTarget_Click"
                        Style="{StaticResource DangerButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
                <Button Content="{DynamicResource Ui_BanKill}"
                        Click="BanAndKillRecommendationTarget_Click"
                        Style="{StaticResource DangerButton}"
                        MinHeight="28"
                        Padding="9,0"
                        Margin="0,0,8,6" />
            </WrapPanel>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="32,0,10,5"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="122" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Ui_Exe}" Style="{StaticResource MutedText}" Margin="0,0,10,0" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource Ui_CurrentProfile}" Style="{StaticResource MutedText}" Margin="0,0,10,0" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Suggested}" Style="{StaticResource MutedText}" Margin="0,0,10,0" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="3" Text="{DynamicResource Ui_Warnings}" Style="{StaticResource MutedText}" Margin="0,0,10,0" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="4" Text="{DynamicResource Ui_Reason}" Style="{StaticResource MutedText}" Margin="0,0,10,0" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="5" Text="{DynamicResource Ui_LastSeen}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" />
                    </Grid>
                </Border>

                <ListBox x:Name="ProfileRecommendationsList"
                         Grid.Row="1"
                         ItemsSource="{Binding ProfileRecommendations}"
                         SelectedItem="{Binding SelectedProfileRecommendation}"
                         SelectionMode="Extended"
                         Background="#11151B"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         MinHeight="44"
                         MaxHeight="300"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RecommendationRow"
                                                Padding="8,0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RecommendationRow" Property="Background" Value="{StaticResource ItemSelectedBrush}" />
                                                <Setter TargetName="RecommendationRow" Property="BorderBrush" Value="{StaticResource ItemSelectedBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RecommendationRow" Property="Background" Value="#1B2630" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Expander Style="{StaticResource RecommendationExpander}"
                                      IsExpanded="False">
                                <Expander.Header>
                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="152" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="122" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ExeName}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,10,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ExeName}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentProfileText}"
                                                   Margin="0,0,10,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileText}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SuggestedProfileText}"
                                                   Margin="0,0,10,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding WarningCountText}"
                                                   Margin="0,0,10,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Reason}"
                                                   Margin="0,0,10,0"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Reason}" />
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding LastSeenText}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Expander.Header>
                                <Border Padding="24,6,8,10"
                                        Background="#12171E"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{DynamicResource Ui_Path}" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding PathText}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding PathText}" />

                                        <TextBlock Grid.Row="2" Text="{DynamicResource Ui_FirstSeen}" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding FirstSeenText}"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="{DynamicResource Ui_LastSeen}"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="3"
                                                   Text="{Binding LastSeenText}"
                                                   TextWrapping="NoWrap" />

                                        <TextBlock Grid.Row="4" Text="{DynamicResource Ui_Details}" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Expander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <TextBlock Grid.Row="6"
                       Text="{Binding ProfileRecommendationStatusText}"
                       Style="{StaticResource MutedText}" />
        </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Ui_DeniedIgnored}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Ui_IgnoredHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="{DynamicResource Ui_RemoveDeny}"
                        Click="RemoveRecommendationDeny_Click"
                        Style="{StaticResource CompactButton}"
                        VerticalAlignment="Top" />
            </Grid>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding DeniedProfileRecommendations}"
                     SelectedItem="{Binding SelectedDeniedProfileRecommendation}"
                     DisplayMemberPath="DisplayText"
                     MinHeight="86"
                     MaxHeight="180"
                     Background="#11151B"
                     BorderBrush="{StaticResource BorderBrushSoft}"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Border>
</Grid>
    </TabItem>

    <TabItem Header="{DynamicResource Ui_Suspicious}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Ui_SuspiciousWatchlistTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Ui_SuspiciousHint}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2"
                                   Orientation="Horizontal"
                                   VerticalAlignment="Top"
                                   MaxWidth="560"
                                   HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Ui_AddExe}"
                                    Click="AddSuspiciousExecutable_Click"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_VerifyPaths}"
                                    Click="VerifyTrackedPaths_Click"
                                    IsEnabled="{Binding CanVerifyTrackedPaths}"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_LocateExe}"
                                    Click="LocateSuspiciousExecutable_Click"
                                    IsEnabled="{Binding CanRelocateSelectedSuspiciousItem}"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_ViewDetails}"
                                    Click="InspectSuspiciousWatchItem_Click"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_RemoveSelected}"
                                    Click="RemoveSelectedSuspiciousWatchItem_Click"
                                    Style="{StaticResource TertiaryButton}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </Grid>

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding SuspiciousWatchItems}"
                              SelectedItem="{Binding SelectedSuspiciousWatchItem}"
                              Style="{StaticResource DataListView}"
                              Visibility="{Binding HasSuspiciousWatchItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui_Exe}" Width="150" DisplayMemberBinding="{Binding ExeName}" />
                                <GridViewColumn Header="{DynamicResource Ui_PathStatus}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tracking.StatusText}"
                                                       ToolTip="{Binding Tracking.TooltipText}"
                                                       TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="present">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="relocated">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="missing">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_LastSeenRunning}" Width="140" DisplayMemberBinding="{Binding Tracking.LastSeenText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Product}" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProductText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Company}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompanyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompanyText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Signer}" Width="90" DisplayMemberBinding="{Binding SignerText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Marked}" Width="145" DisplayMemberBinding="{Binding MarkedAtText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Path}" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2"
                            Padding="18"
                            CornerRadius="8"
                            Background="#11151B"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSuspiciousWatchItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoSuspiciousItems}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding SuspiciousWatchStatusText}"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TrackedPathsStatusText}"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding SelectedSuspiciousWatchItem.Tracking.FingerprintText}"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedSuspiciousWatchItem.Tracking.TooltipText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Ui_LaunchHistory}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding SuspiciousLaunchEntries}"
                              Style="{StaticResource DataListView}"
                              Visibility="{Binding HasSuspiciousLaunchEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui_Time}" Width="145" DisplayMemberBinding="{Binding TimestampText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Exe}" Width="150" DisplayMemberBinding="{Binding ExeName}" />
                                <GridViewColumn Header="{DynamicResource Ui_Company}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompanyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompanyText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Signer}" Width="90" DisplayMemberBinding="{Binding SignerText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Parent}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ParentText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParentText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Mode}" Width="110" DisplayMemberBinding="{Binding WatchModeText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Border Grid.Row="2"
                            Padding="18"
                            CornerRadius="8"
                            Background="#11151B"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSuspiciousLaunchEntries}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoSuspiciousLaunches}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </TabItem>

    <TabItem Header="{DynamicResource Ui_Bans}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ui_ProcessBans}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Ui_ProcessBansHint}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Right"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right"
                                   MaxWidth="520">
                            <Button Content="{DynamicResource Ui_AddExe}"
                                    Click="AddBanExecutable_Click"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_VerifyPaths}"
                                    Click="VerifyTrackedPaths_Click"
                                    IsEnabled="{Binding CanVerifyTrackedPaths}"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_LocateExe}"
                                    Click="LocateBanExecutable_Click"
                                    IsEnabled="{Binding CanRelocateSelectedProcessBan}"
                                    Style="{StaticResource CompactButton}"
                                    Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Ui_RemoveSelected}"
                                    Click="RemoveSelectedProcessBan_Click"
                                    IsEnabled="{Binding CanRemoveSelectedProcessBan}"
                                    Style="{StaticResource TertiaryButton}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                    </DockPanel>

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding ProcessBans}"
                              SelectedItem="{Binding SelectedProcessBan}"
                              Style="{StaticResource DataListView}"
                              Visibility="{Binding HasProcessBans, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui_Exe}" Width="150" DisplayMemberBinding="{Binding ExeName}" />
                                <GridViewColumn Header="{DynamicResource Ui_PathStatus}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tracking.StatusText}"
                                                       ToolTip="{Binding Tracking.TooltipText}"
                                                       TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="present">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="relocated">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tracking.StatusKey}" Value="missing">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Duration}" Width="100" DisplayMemberBinding="{Binding DurationText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Expires}" Width="150" DisplayMemberBinding="{Binding ExpiresText}" />
                                <GridViewColumn Header="{DynamicResource Ui_LastSeenRunning}" Width="140" DisplayMemberBinding="{Binding Tracking.LastSeenText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Company}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompanyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompanyText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Signer}" Width="110" DisplayMemberBinding="{Binding SignerText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Path}" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2"
                            Padding="18"
                            CornerRadius="8"
                            Background="#11151B"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProcessBans}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoBans}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding ProcessBanStatusText}"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TrackedPathsStatusText}"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding SelectedProcessBan.Tracking.FingerprintText}"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedProcessBan.Tracking.TooltipText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ui_BanHistory}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Ui_BanHistoryHint}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Ui_ExportHtml}"
                                    Click="ExportProcessActionAuditHtml_Click"
                                    IsEnabled="{Binding HasProcessBanEvents}"
                                    Style="{StaticResource CompactButton}" />
                            <Button Content="{DynamicResource Ui_ExportCsv}"
                                    Click="ExportProcessActionAuditCsv_Click"
                                    IsEnabled="{Binding HasProcessBanEvents}"
                                    Style="{StaticResource CompactButton}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding ProcessBanEvents}"
                              Style="{StaticResource DataListView}"
                              Visibility="{Binding HasProcessBanEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui_Time}" Width="145" DisplayMemberBinding="{Binding TimestampText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Action}" Width="120" DisplayMemberBinding="{Binding ActionText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Exe}" Width="150" DisplayMemberBinding="{Binding ExeName}" />
                                <GridViewColumn Header="{DynamicResource Ui_Duration}" Width="100" DisplayMemberBinding="{Binding DurationText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Terminated}" Width="85" DisplayMemberBinding="{Binding TerminatedText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Process}" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Details}" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailsText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Border Grid.Row="2"
                            Padding="18"
                            CornerRadius="8"
                            Background="#11151B"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProcessBanEvents}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoBanEvents}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </TabItem>
</TabControl>
</UserControl>
