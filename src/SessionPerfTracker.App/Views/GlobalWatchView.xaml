                                <GridViewColumn Header="{DynamicResource Ui_Signer}" Width="90" DisplayMemberBinding="{Binding SignerText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Marked}" Width="145" DisplayMemberBinding="{Binding MarkedAtText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Path}" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2"
                            Padding="18"
                            CornerRadius="8"
                            Background="#0C1526"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSuspiciousWatchItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoSuspiciousItems}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding SuspiciousWatchStatusText}"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TrackedPathsStatusText}"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding SelectedSuspiciousWatchItem.Tracking.FingerprintText}"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedSuspiciousWatchItem.Tracking.TooltipText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Ui_LaunchHistory}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding SuspiciousLaunchEntries}"
                              Style="{StaticResource DataListView}"
                              Visibility="{Binding HasSuspiciousLaunchEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui_Time}" Width="145" DisplayMemberBinding="{Binding TimestampText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Exe}" Width="150" DisplayMemberBinding="{Binding ExeName}" />
                                <GridViewColumn Header="{DynamicResource Ui_Company}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompanyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompanyText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Signer}" Width="90" DisplayMemberBinding="{Binding SignerText}" />
                                <GridViewColumn Header="{DynamicResource Ui_Parent}" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ParentText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParentText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource Ui_Mode}" Width="110" DisplayMemberBinding="{Binding WatchModeText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Border Grid.Row="2"
                            Padding="18"
                            CornerRadius="8"
                            Background="#0C1526"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSuspiciousLaunchEntries}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource Ui_NoSuspiciousLaunches}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </TabItem>

