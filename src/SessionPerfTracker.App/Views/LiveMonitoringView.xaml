<UserControl x:Class="SessionPerfTracker.App.Views.LiveMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SessionPerfTracker.App.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SessionPerfTracker.App;component/Themes/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <controls:HeatBrushConverter x:Key="HeatBrush" />
            <controls:RowNumberConverter x:Key="RowNumber" />
            <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <Style x:Key="TileSparkline" TargetType="controls:Sparkline">
                <Setter Property="Height" Value="54" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Capacity" Value="90" />
                <Setter Property="Stroke" Value="{StaticResource CpuAccentBrush}" />
                <Setter Property="Fill" Value="{StaticResource CpuFillBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Accent}" Value="ram">
                        <Setter Property="Stroke" Value="{StaticResource RamAccentBrush}" />
                        <Setter Property="Fill" Value="{StaticResource RamFillBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="gpu">
                        <Setter Property="Stroke" Value="{StaticResource GpuAccentBrush}" />
                        <Setter Property="Fill" Value="{StaticResource GpuFillBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="disk">
                        <Setter Property="Stroke" Value="{StaticResource DiskAccentBrush}" />
                        <Setter Property="Fill" Value="{StaticResource DiskFillBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TileIcon" TargetType="controls:IconGlyph">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Data" Value="{StaticResource IconCpu}" />
                <Setter Property="Brush" Value="{StaticResource CpuAccentBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Accent}" Value="ram">
                        <Setter Property="Data" Value="{StaticResource IconRam}" />
                        <Setter Property="Brush" Value="{StaticResource RamAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="gpu">
                        <Setter Property="Data" Value="{StaticResource IconGpu}" />
                        <Setter Property="Brush" Value="{StaticResource GpuAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="disk">
                        <Setter Property="Data" Value="{StaticResource IconDisk}" />
                        <Setter Property="Brush" Value="{StaticResource DiskAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TileValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Accent}" Value="gpu">
                        <Setter Property="Foreground" Value="#C084FC" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="disk">
                        <Setter Property="Foreground" Value="#4ADE80" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CardIcon" TargetType="controls:IconGlyph">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Brush" Value="{StaticResource AccentTextBrush}" />
            </Style>

            <Style x:Key="SegmentButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="#17345F" />
                        <Setter Property="Foreground" Value="#DBEAFE" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LegendDot" TargetType="Ellipse">
                <Setter Property="Width" Value="9" />
                <Setter Property="Height" Value="9" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="HeatCell" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="2,0" />
            </Style>

            <Style x:Key="TableHeader" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Margin" Value="8,0" />
            </Style>

            <Style x:Key="DrawerLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="Margin" Value="0,16,0,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer Style="{StaticResource PageScrollViewer}">
            <StackPanel Margin="16,0,16,8">
                <Border Visibility="{Binding HasLiveWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,12"
                        Padding="12,9"
                        CornerRadius="10"
                        Background="#2A1219"
                        BorderBrush="#B83A44"
                        BorderThickness="1">
                    <TextBlock Text="{Binding LiveWarningText}" Foreground="#FCA5A5" FontWeight="SemiBold" />
                </Border>

                <!-- Monitored target. -->
                <Border Padding="18,16" CornerRadius="12" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="recording">
                                    <Setter Property="BorderBrush" Value="#1F8A4C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="warning">
                                    <Setter Property="BorderBrush" Value="#8A6A1C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="danger">
                                    <Setter Property="BorderBrush" Value="#B83A44" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="52"
                                Height="52"
                                CornerRadius="12"
                                Background="{StaticResource PanelStrongBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                Margin="0,0,14,0">
                            <Grid>
                                <controls:IconGlyph Data="{StaticResource IconMonitor}" Brush="{StaticResource MutedBrush}" Width="24" Height="24" />
                                <controls:ExeIcon Path="{Binding LiveTargetIconPath}" Width="30" Height="30" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LiveTargetNameText}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="520"
                                           ToolTip="{Binding LiveTargetNameText}" />
                                <Border Margin="12,0,0,0" Padding="9,3" CornerRadius="10" VerticalAlignment="Center" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14213A" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="recording">
                                                    <Setter Property="Background" Value="#0F2E1E" />
                                                    <Setter Property="BorderBrush" Value="#1F8A4C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="warning">
                                                    <Setter Property="Background" Value="#2A2210" />
                                                    <Setter Property="BorderBrush" Value="#8A6A1C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="danger">
                                                    <Setter Property="Background" Value="#2A1219" />
                                                    <Setter Property="BorderBrush" Value="#B83A44" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="recording">
                                                            <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="warning">
                                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="danger">
                                                            <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding LiveSessionStateText}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding LiveTargetPathText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LiveTargetPathText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ui_Duration}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding LiveElapsedText}" FontSize="22" FontWeight="SemiBold" TextWrapping="NoWrap" />
                            </StackPanel>
                            <Button Click="StartRecording_Click"
                                    Style="{StaticResource HeroPrimaryButton}"
                                    MinWidth="168"
                                    Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisibility}}"
                                    IsEnabled="{Binding CanStart}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconPlay}" IsFilled="True" Brush="White" Width="14" Height="14" Margin="0,0,10,0" />
                                    <TextBlock Text="{DynamicResource Ui_StartMonitoring}" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="StopRecording_Click"
                                    Style="{StaticResource HeroDangerButton}"
                                    MinWidth="168"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}"
                                    IsEnabled="{Binding CanStop}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconStop}" IsFilled="True" Brush="#FCA5A5" Width="13" Height="13" Margin="0,0,10,0" />
                                    <TextBlock Text="{DynamicResource Ui_StopMonitoring}" Foreground="#FCA5A5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenTargetPicker_Click" MinHeight="44" Padding="16,0" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconTarget}" Brush="{StaticResource TextBrush}" Width="18" Height="18" Margin="0,0,10,0" />
                                    <TextBlock Text="{DynamicResource Ui_ChangeTarget}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Session settings that apply to the current or next recording. -->
                        <Border Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0,14,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,1,0,0">
                            <WrapPanel>
                                <StackPanel Margin="0,0,28,0" MinWidth="70">
                                    <TextBlock Text="{DynamicResource Ui_Pid}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding LivePidText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0" Width="170">
                                    <TextBlock Text="{DynamicResource Ui_FieldChildProcesses}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ChildScopeOptions}"
                                              SelectedIndex="{Binding SelectedChildScopeIndex}"
                                              MinHeight="30"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0" Width="210">
                                    <TextBlock Text="{DynamicResource Ui_FieldActiveProfile}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding SessionProfileOptions}"
                                              SelectedItem="{Binding SelectedSessionProfileOption}"
                                              DisplayMemberPath="DisplayName"
                                              MinHeight="30"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0" Width="240">
                                    <TextBlock Text="{DynamicResource Ui_Sampling}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding SamplingOptions}"
                                              SelectedItem="{Binding SelectedSamplingOption}"
                                              DisplayMemberPath="Label"
                                              MinHeight="30"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="{DynamicResource Ui_Samples}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding LiveSamplesText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="{DynamicResource Ui_Events}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding LiveEventsText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI tiles: target while recording, whole system otherwise. -->
                <ItemsControl ItemsSource="{Binding LiveTiles}" Margin="0,14,-14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MetricCard}"
                                    Tag="{Binding Tone}"
                                    CornerRadius="12"
                                    Padding="16,14,16,10"
                                    Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:IconGlyph Style="{StaticResource TileIcon}" />
                                        <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DetailText}"
                                               Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="10,0,0,0"
                                               ToolTip="{Binding DetailText}" />
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource TileValue}" />
                                        <TextBlock Text="{Binding SubValueText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="15"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,5"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Detail2Text}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                    <controls:Sparkline Grid.Row="3"
                                                        Grid.ColumnSpan="2"
                                                        Values="{Binding History}"
                                                        Maximum="{Binding ScaleMaximum}"
                                                        Style="{StaticResource TileSparkline}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Timeline and events. -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="16,14,16,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding TimelineRanges}"
                                              SelectedItem="{Binding SelectedTimelineRange}"
                                              DisplayMemberPath="Label"
                                              Width="140"
                                              MinHeight="32"
                                              Margin="0" />
                                    <Button Style="{StaticResource IconButton}" Click="ZoomInTimeline_Click" ToolTip="{DynamicResource Ui_ZoomIn}" Margin="8,0,0,0">
                                        <controls:IconGlyph Data="{StaticResource IconZoomIn}" Brush="{StaticResource TextBrush}" Width="17" Height="17" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="ZoomOutTimeline_Click" ToolTip="{DynamicResource Ui_ZoomOut}" Margin="6,0,0,0">
                                        <controls:IconGlyph Data="{StaticResource IconZoomOut}" Brush="{StaticResource TextBrush}" Width="17" Height="17" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconChart}" Style="{StaticResource CardIcon}" />
                                    <TextBlock Text="{DynamicResource Ui_PerformanceTimeline}" Style="{StaticResource CardTitle}" />
                                    <Border Margin="16,0,0,0"
                                            Padding="3"
                                            CornerRadius="8"
                                            Background="{StaticResource SurfaceSunkenBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SegmentButton}"
                                                    Tag="{Binding TimelineShowsSession}"
                                                    IsEnabled="{Binding HasSessionTimeline}"
                                                    Content="{DynamicResource Ui_TimelineSession}"
                                                    Click="ShowSessionTimeline_Click" />
                                            <Button Style="{StaticResource SegmentButton}"
                                                    Tag="{Binding TimelineShowsSystem}"
                                                    Content="{DynamicResource Ui_TimelineSystem}"
                                                    Click="ShowSystemTimeline_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="2,12,0,4">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource CpuAccentBrush}" />
                                <TextBlock Text="{DynamicResource Ui_LegendCpu}" Style="{StaticResource LegendText}" />
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource GpuAccentBrush}" />
                                <TextBlock Text="{DynamicResource Ui_LegendGpu}" Style="{StaticResource LegendText}" />
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource RamAccentBrush}" />
                                <TextBlock Text="{DynamicResource Ui_LegendRam}" Style="{StaticResource LegendText}" />
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource DiskAccentBrush}" />
                                <TextBlock Text="{DynamicResource Ui_LegendDisk}" Style="{StaticResource LegendText}" />
                                <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource BadBrush}" />
                                <TextBlock Text="{DynamicResource Ui_LegendEvents}" Style="{StaticResource LegendText}" />
                            </WrapPanel>
                            <controls:TimelineChart Grid.Row="2"
                                                    Height="290"
                                                    History="{Binding ActiveTimeline}"
                                                    Version="{Binding TimelineVersion}"
                                                    WindowSeconds="{Binding TimelineWindowSeconds}"
                                                    EmptyText="{Binding TimelineEmptyText}"
                                                    CpuLabel="{DynamicResource Ui_CPU}"
                                                    GpuLabel="{DynamicResource Ui_GpuShort}"
                                                    RamLabel="{DynamicResource Ui_RAM}"
                                                    DiskLabel="{DynamicResource Ui_Disk}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource LinkButton}"
                                        Content="{DynamicResource Ui_ViewAll}"
                                        Click="ViewAllEvents_Click"
                                        IsEnabled="{Binding HasLastCompletedSession}" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconAlert}" Style="{StaticResource CardIcon}" Brush="{StaticResource WarnBrush}" />
                                    <TextBlock Text="{DynamicResource Ui_RecentEvents}" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1"
                                          Height="318"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasLiveEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding VisibleEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource SeverityBadge}" Tag="{Binding Severity}" VerticalAlignment="Top" Margin="0,8,10,0">
                                                    <controls:IconGlyph Brush="White" Width="14" Height="14" StrokeWeight="2.6">
                                                        <controls:IconGlyph.Style>
                                                            <Style TargetType="controls:IconGlyph">
                                                                <Setter Property="Data" Value="{StaticResource IconExclaim}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                        <Setter Property="Data" Value="{StaticResource IconInfoMark}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:IconGlyph.Style>
                                                    </controls:IconGlyph>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource MutedText}" Margin="0,10,12,0" TextWrapping="NoWrap" />
                                                <Border Grid.Column="2" Padding="0,8,0,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}" />
                                                        <TextBlock Text="{Binding Details}"
                                                                   Style="{StaticResource MutedText}"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="34"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Details}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border Grid.Row="1"
                                    Height="318"
                                    Style="{StaticResource EmptyState}"
                                    Visibility="{Binding HasLiveEvents, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <controls:IconGlyph Data="{StaticResource IconShield}" Brush="{StaticResource GoodBrush}" Width="34" Height="34" />
                                    <TextBlock Text="{Binding LiveEventEmptyText}"
                                               Style="{StaticResource MutedText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- System context, memory and session summary. -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ComboBox DockPanel.Dock="Right"
                                          ItemsSource="{Binding LiveTopSortOptions}"
                                          SelectedIndex="{Binding SelectedLiveTopSortIndex}"
                                          Width="150"
                                          MinHeight="30"
                                          Margin="0" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconBars}" Style="{StaticResource CardIcon}" />
                                    <TextBlock Text="{DynamicResource Ui_TopProcessesSystem}" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource TableHeader}" Margin="4,0" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Ui_Process}" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Pid}" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="3" Text="{DynamicResource Ui_CPU}" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="4" Text="{DynamicResource Ui_GpuShort}" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="5" Text="{DynamicResource Ui_RAM}" Style="{StaticResource TableHeader}" />
                                <TextBlock Grid.Column="6" Text="{DynamicResource Ui_Disk}" Style="{StaticResource TableHeader}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LiveTopProcesses}" AlternationCount="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource RowNumber}}"
                                                           Style="{StaticResource MutedText}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                                                    <controls:ExeIcon Path="{Binding IconPath}" Width="18" Height="18" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ProcessIdText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border Grid.Column="3" Style="{StaticResource HeatCell}" Background="{Binding CpuPercent, Converter={StaticResource HeatBrush}, ConverterParameter=cpu}">
                                                    <TextBlock Text="{Binding CpuText}" TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="4" Style="{StaticResource HeatCell}" Background="{Binding GpuPercent, Converter={StaticResource HeatBrush}, ConverterParameter=gpu}">
                                                    <TextBlock Text="{Binding GpuText}" TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="5" Style="{StaticResource HeatCell}" Background="{Binding MemoryMb, Converter={StaticResource HeatBrush}, ConverterParameter=ram}">
                                                    <TextBlock Text="{Binding MemoryText}" TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="6" Style="{StaticResource HeatCell}" Background="{Binding DiskTotalMbPerSec, Converter={StaticResource HeatBrush}, ConverterParameter=disk}">
                                                    <TextBlock Text="{Binding DiskTotalText}" TextWrapping="NoWrap" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <controls:IconGlyph Data="{StaticResource IconMemoryChip}" Style="{StaticResource CardIcon}" Brush="{StaticResource RamAccentBrush}" />
                                <TextBlock Text="{DynamicResource Ui_Memory}" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource ThinMeter}" Height="6" Value="{Binding RamUsedPercent, Mode=OneWay}" Foreground="{StaticResource RamAccentBrush}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                        <Setter Property="Margin" Value="0,0,0,9" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Ui_RamTotal}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding RamTotalText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource Ui_RamInUse}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RamInUseText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource Ui_RamAvailable}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamAvailableText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="3" Text="{Binding RamPeakLabel}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RamPeakText}" HorizontalAlignment="Right" Foreground="#FCA5A5" />
                                <TextBlock Grid.Row="4" Text="{DynamicResource Ui_RamCommitted}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RamCommitText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="5" Text="{DynamicResource Ui_RamPressure}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RamPressureText}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                            <Setter Property="Margin" Value="0,0,0,9" />
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RamPressureTone}" Value="warn">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RamPressureTone}" Value="bad">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource LinkButton}"
                                        Content="{DynamicResource Ui_OpenDetails}"
                                        Click="OpenLastCompletedSession_Click"
                                        Visibility="{Binding ShowLastCompletedSessionInLive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconGlyph Data="{StaticResource IconSummary}" Style="{StaticResource CardIcon}" />
                                    <TextBlock Text="{DynamicResource Ui_SessionSummary}" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid Visibility="{Binding HasSummarySession, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                        <Setter Property="Margin" Value="0,0,0,9" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Ui_SummaryStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,9" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,9">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SummaryStatusText}" Margin="0" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{DynamicResource Ui_SummaryStart}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,9" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryStartText}" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource Ui_Duration}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,9" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SummaryDurationText}" />
                                <TextBlock Grid.Row="3" Text="{DynamicResource Ui_SummaryTarget}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,9" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SummaryTargetText}" ToolTip="{Binding SummaryTargetText}" />
                                <TextBlock Grid.Row="4" Text="{DynamicResource Ui_FieldChildProcesses}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,9" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SummaryChildText}" />
                                <TextBlock Grid.Row="5" Text="{DynamicResource Ui_FieldActiveProfile}" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,9" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SummaryProfileText}" ToolTip="{Binding SummaryProfileText}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Ui_SummaryNoSession}"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasSummarySession, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Target picker drawer. -->
        <Grid Visibility="{Binding IsTargetPickerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#B3060A12" MouseLeftButtonDown="TargetPickerBackdrop_MouseDown" />
            <Border HorizontalAlignment="Right"
                    Width="430"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,18,16,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="CloseTargetPicker_Click">
                            <controls:IconGlyph Data="{StaticResource IconClose}" Brush="{StaticResource TextBrush}" Width="16" Height="16" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph Data="{StaticResource IconTarget}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="{DynamicResource Ui_ChangeTargetTitle}" Style="{StaticResource CardTitle}" FontSize="17" />
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                        <Button Content="{DynamicResource Ui_Done}" Click="CloseTargetPicker_Click" Style="{StaticResource AccentButton}" />
                    </Border>
                    <ScrollViewer Style="{StaticResource PageScrollViewer}">
                        <StackPanel Margin="20,4,20,16">
                            <TextBlock Text="{DynamicResource Ui_TargetSource}" Style="{StaticResource DrawerLabel}" Margin="0,8,0,0" />
                            <ComboBox ItemsSource="{Binding TargetModes}" SelectedItem="{Binding SelectedTargetMode}" />

                            <StackPanel Visibility="{Binding IsRunningProcessMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="RefreshProcesses_Click" ToolTip="{DynamicResource Ui_Refresh}" Margin="8,0,0,0">
                                        <controls:IconGlyph Data="{StaticResource IconRefresh}" Brush="{StaticResource TextBrush}" Width="16" Height="16" />
                                    </Button>
                                    <Grid>
                                        <TextBox Text="{Binding ProcessFilterText, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Padding="30,4,8,4" />
                                        <controls:IconGlyph Data="{StaticResource IconSearch}" Brush="{StaticResource PlaceholderBrush}" Width="15" Height="15" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                                        <TextBlock Text="{DynamicResource Ui_SearchProcesses}"
                                                   IsHitTestVisible="False"
                                                   Foreground="{StaticResource PlaceholderBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="32,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProcessFilterText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding RunningTargets}"
                                         SelectedItem="{Binding SelectedRunningTarget}"
                                         Height="300"
                                         Margin="0,8,0,0"
                                         Background="{StaticResource SurfaceSunkenBrush}"
                                         BorderBrush="{StaticResource BorderBrushSoft}"
                                         BorderThickness="1"
                                         Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsAssignedAppsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="RefreshProcesses_Click" ToolTip="{DynamicResource Ui_Refresh}" Margin="8,0,0,0">
                                        <controls:IconGlyph Data="{StaticResource IconRefresh}" Brush="{StaticResource TextBrush}" Width="16" Height="16" />
                                    </Button>
                                    <ComboBox ItemsSource="{Binding AssignedTargets}" SelectedItem="{Binding SelectedAssignedTarget}" DisplayMemberPath="DisplayText" Margin="0" />
                                </DockPanel>
                                <TextBlock Text="{DynamicResource Ui_AssignedAppsHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsExecutableMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="{DynamicResource Ui_ChooseExe}" Click="BrowseExecutable_Click" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedExecutableDisplay}"
                                           Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedExecutableDisplay}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Ui_CaptureOptions}" Style="{StaticResource DrawerLabel}" />
                            <CheckBox Content="{DynamicResource Ui_IncludeChildProcesses}" IsChecked="{Binding IncludeChildProcesses}" />
                            <CheckBox Content="{DynamicResource Ui_CaptureGpu}" IsChecked="{Binding CaptureGpu}" />
                            <CheckBox Content="{DynamicResource Ui_LiveMonitor}" IsChecked="{Binding IsLiveMonitorEnabled}" />
                            <TextBlock Text="{Binding RecordingStatusText}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />

                            <Expander Header="{DynamicResource Ui_Assignments}" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Ui_AssignCurrentTarget}" Style="{StaticResource MutedText}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right"
                                                Content="{DynamicResource Ui_Assign}"
                                                Click="AssignCurrentTargetProfile_Click"
                                                Style="{StaticResource CompactButton}"
                                                Margin="8,6,0,0" />
                                        <ComboBox ItemsSource="{Binding ThresholdProfiles}" SelectedItem="{Binding SelectedLiveAssignmentProfile}" DisplayMemberPath="DisplayName" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding LiveAssignmentStatusText}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="{DynamicResource Ui_Diagnostics}" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <Button Content="{DynamicResource Ui_RamDiagnosticSnapshot}" Click="CaptureRamDiagnostic_Click" Style="{StaticResource TertiaryButton}" />
                                    <TextBox Text="{Binding RamDiagnosticText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             MinHeight="72"
                                             MaxHeight="140"
                                             Margin="0,8,0,0" />
                                    <Button Content="{DynamicResource Ui_SystemContextSnapshot}" Click="CaptureSystemContext_Click" Style="{StaticResource TertiaryButton}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding SystemContextText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             MinHeight="72"
                                             MaxHeight="140"
                                             Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
