<UserControl x:Class="SessionPerfTracker.App.Views.LiveMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SessionPerfTracker.App.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SessionPerfTracker.App;component/Themes/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TileSparkline" TargetType="controls:Sparkline">
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Capacity" Value="90" />
                <Setter Property="Stroke" Value="{StaticResource CpuAccentBrush}" />
                <Setter Property="Fill" Value="{StaticResource CpuFillBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Accent}" Value="ram">
                        <Setter Property="Stroke" Value="{StaticResource RamAccentBrush}" />
                        <Setter Property="Fill" Value="{StaticResource RamFillBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="gpu">
                        <Setter Property="Stroke" Value="{StaticResource GpuAccentBrush}" />
                        <Setter Property="Fill" Value="{StaticResource GpuFillBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="disk">
                        <Setter Property="Stroke" Value="{StaticResource DiskAccentBrush}" />
                        <Setter Property="Fill" Value="{StaticResource DiskFillBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TileAccentBar" TargetType="Border">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="12" />
                <Setter Property="CornerRadius" Value="1.5" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="Background" Value="{StaticResource CpuAccentBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Accent}" Value="ram">
                        <Setter Property="Background" Value="{StaticResource RamAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="gpu">
                        <Setter Property="Background" Value="{StaticResource GpuAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Accent}" Value="disk">
                        <Setter Property="Background" Value="{StaticResource DiskAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,6" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

<ScrollViewer Style="{StaticResource PageScrollViewer}">
    <Grid Margin="16,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Session header: state, target and the primary actions. -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Padding="16,14"
                CornerRadius="8"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="recording">
                            <Setter Property="BorderBrush" Value="#2C7A5B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="warning">
                            <Setter Property="BorderBrush" Value="#8A6A1C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="danger">
                            <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="recording">
                                            <Setter Property="Background" Value="#123326" />
                                            <Setter Property="BorderBrush" Value="#2C7A5B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="warning">
                                            <Setter Property="Background" Value="#2A2210" />
                                            <Setter Property="BorderBrush" Value="#8A6A1C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="danger">
                                            <Setter Property="Background" Value="#2A1618" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="recording">
                                                    <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="warning">
                                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LiveSessionStateTone}" Value="danger">
                                                    <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LiveSessionStateText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LiveSessionTargetText}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="720"
                                   ToolTip="{Binding LiveSessionTargetText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LiveSessionMetaText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LiveSessionMetaText}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding LiveSessionHintText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ui_Duration}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ui_Samples}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding SampleCountText}" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ui_Events}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding EventCountText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button Content="{DynamicResource Ui_Start}"
                            Click="StartRecording_Click"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource HeroPrimaryButton}"
                            MinWidth="112"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Ui_Stop}"
                            Click="StopRecording_Click"
                            Style="{StaticResource HeroDangerButton}"
                            IsEnabled="{Binding CanStop}"
                            MinWidth="112" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI tiles with short live history. -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <ItemsControl ItemsSource="{Binding LiveTiles}"
                          Visibility="{Binding HasActiveLiveMetrics, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCard}"
                                Tag="{Binding Tone}"
                                Margin="0,0,10,0">
                            <Border.Resources>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Resources>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource TileAccentBar}" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ValueText}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding DetailText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="11" />
                                <controls:Sparkline Values="{Binding History}"
                                                    Maximum="{Binding ScaleMaximum}"
                                                    Style="{StaticResource TileSparkline}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Visibility="{Binding ShowLiveSnapshotEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource EmptyState}"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LiveSnapshotTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LiveSnapshotEmptyText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LiveSnapshotScopeText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LiveConfigCollectorsText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Setup column. -->
        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Panel}" VerticalAlignment="Top">
            <StackPanel>
                <Border Visibility="{Binding HasLiveWarning, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,12"
                        Padding="10"
                        CornerRadius="8"
                        Background="#2A1618"
                        BorderBrush="{StaticResource BadBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding LiveWarningText}"
                               Foreground="{StaticResource BadBrush}"
                               FontWeight="SemiBold" />
                </Border>

                <TextBlock Text="{DynamicResource Ui_Target}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Ui_TargetSource}" Style="{StaticResource SectionHeader}" Margin="0,10,0,0" />
                <ComboBox ItemsSource="{Binding TargetModes}"
                          SelectedItem="{Binding SelectedTargetMode}"
                          Margin="0,4,0,0" />

                <StackPanel Visibility="{Binding IsRunningProcessMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource Ui_Refresh}"
                                Click="RefreshProcesses_Click"
                                Style="{StaticResource CompactButton}" />
                        <Grid Margin="0,0,8,0">
                            <TextBox Text="{Binding ProcessFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="30" />
                            <TextBlock Text="{DynamicResource Ui_SearchProcesses}"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource PlaceholderBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProcessFilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding RunningTargets}"
                              SelectedItem="{Binding SelectedRunningTarget}"
                              DisplayMemberPath="DisplayName"
                              MaxDropDownHeight="420" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsAssignedAppsMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource Ui_Refresh}"
                                Click="RefreshProcesses_Click"
                                Style="{StaticResource CompactButton}" />
                        <TextBlock Text="{DynamicResource Ui_AssignedAppsProfiles}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding AssignedTargets}"
                              SelectedItem="{Binding SelectedAssignedTarget}"
                              DisplayMemberPath="DisplayText" />
                    <TextBlock Text="{DynamicResource Ui_AssignedAppsHint}"
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsExecutableMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="{DynamicResource Ui_ChooseExe}"
                            Click="BrowseExecutable_Click"
                            Margin="0,12,0,0" />
                    <TextBlock Text="{Binding SelectedExecutableDisplay}"
                               Style="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedExecutableDisplay}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Ui_Session}" Style="{StaticResource SectionHeader}" Margin="0,18,0,0" />
                <TextBlock Text="{DynamicResource Ui_SessionProfile}" Style="{StaticResource MutedText}" />
                <ComboBox ItemsSource="{Binding SessionProfileOptions}"
                          SelectedItem="{Binding SelectedSessionProfileOption}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Text="{DynamicResource Ui_Sampling}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                <ComboBox ItemsSource="{Binding SamplingOptions}"
                          SelectedItem="{Binding SelectedSamplingOption}"
                          DisplayMemberPath="Label" />
                <CheckBox Content="{DynamicResource Ui_IncludeChildProcesses}" IsChecked="{Binding IncludeChildProcesses}" Margin="0,12,0,0" />
                <CheckBox Content="{DynamicResource Ui_CaptureGpu}" IsChecked="{Binding CaptureGpu}" />
                <CheckBox Content="{DynamicResource Ui_LiveMonitor}" IsChecked="{Binding IsLiveMonitorEnabled}" />
                <TextBlock Text="{Binding RecordingStatusText}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <Expander Header="{DynamicResource Ui_Assignments}"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,14,0,0"
                          IsExpanded="False">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Ui_AssignCurrentTarget}" Style="{StaticResource MutedText}" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="{DynamicResource Ui_Assign}"
                                    Click="AssignCurrentTargetProfile_Click"
                                    Style="{StaticResource CompactButton}"
                                    Margin="8,6,0,0" />
                            <ComboBox ItemsSource="{Binding ThresholdProfiles}"
                                      SelectedItem="{Binding SelectedLiveAssignmentProfile}"
                                      DisplayMemberPath="DisplayName" />
                        </DockPanel>
                        <TextBlock Text="{Binding LiveAssignmentStatusText}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="42"
                                   ToolTip="{Binding LiveAssignmentStatusText}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>

                <Expander Header="{DynamicResource Ui_Diagnostics}"
                          Foreground="{StaticResource TextBrush}"
                          Margin="0,10,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <Button Content="{DynamicResource Ui_RamDiagnosticSnapshot}"
                                Click="CaptureRamDiagnostic_Click"
                                Style="{StaticResource TertiaryButton}" />
                        <TextBox Text="{Binding RamDiagnosticText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="72"
                                 MaxHeight="140"
                                 Margin="0,8,0,0" />
                        <Button Content="{DynamicResource Ui_SystemContextSnapshot}"
                                Click="CaptureSystemContext_Click"
                                Style="{StaticResource TertiaryButton}"
                                Margin="0,12,0,0" />
                        <TextBox Text="{Binding SystemContextText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="72"
                                 MaxHeight="140"
                                 Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Right column: whole-system load and events. -->
        <StackPanel Grid.Row="4" Grid.Column="2">
            <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_SystemCpu}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemCpuText}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemCpuPercent, Mode=OneWay}" Foreground="{StaticResource CpuAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_SystemRam}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemRamText}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemRamPercent, Mode=OneWay}" Foreground="{StaticResource RamAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" ToolTip="{Binding SystemGpuNameText}">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_GpuShort}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemGpuText}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemGpuPercent, Mode=OneWay}" Foreground="{StaticResource GpuAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Ui_VramShort}" Style="{StaticResource MetricLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SystemVramText}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinMeter}" Value="{Binding SystemVramPercent, Mode=OneWay}" Foreground="{StaticResource GpuAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Ui_Events}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LiveSnapshotStatusText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VisibleEvents}"
                                  Visibility="{Binding HasLiveEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        Margin="0,0,0,8"
                                        CornerRadius="8"
                                        Background="{StaticResource SurfaceSunkenBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" CornerRadius="1.5" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Background" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}">
                                                <Run Text="{Binding Kind, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Metric, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ContextSummaryText}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ObservedText}" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Visibility="{Binding ShowLiveEventEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource EmptyState}">
                        <TextBlock Text="{Binding LiveEventEmptyText}"
                                   Style="{StaticResource MutedText}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</ScrollViewer>
</UserControl>
