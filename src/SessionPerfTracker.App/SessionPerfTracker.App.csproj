<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SessionPerfTracker.Domain\SessionPerfTracker.Domain.csproj" />
    <ProjectReference Include="..\SessionPerfTracker.Infrastructure\SessionPerfTracker.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SessionPerfTracker.App</AssemblyName>
    <Product>Session Perf Tracker</Product>
    <Company>Session Perf Tracker</Company>
    <Authors>Session Perf Tracker</Authors>
    <Description>Windows desktop app for recording app and game performance sessions, spotting CPU/RAM/GPU/disk spikes, and collecting useful feedback reports while the project is still early.</Description>
    <PackageDescription>Windows desktop app for recording app and game performance sessions, spotting CPU/RAM/GPU/disk spikes, and collecting useful feedback reports while the project is still early.</PackageDescription>
    <VersionFile>$(MSBuildProjectDirectory)\..\..\VERSION</VersionFile>
    <ProjectVersion Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</ProjectVersion>
    <ProjectVersion Condition="'$(ProjectVersion)' == ''">1.7.0</ProjectVersion>
    <Version>$(ProjectVersion)</Version>
    <AssemblyVersion>$(ProjectVersion).0</AssemblyVersion>
    <FileVersion>$(ProjectVersion).0</FileVersion>
    <InformationalVersion>$(ProjectVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
